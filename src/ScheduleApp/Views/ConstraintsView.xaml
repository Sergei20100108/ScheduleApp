<UserControl x:Class="ScheduleApp.Views.ConstraintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:domain="clr-namespace:ScheduleApp.Domain"
             Background="{DynamicResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="PreferenceKinds" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domain:PreferenceKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="WeekDays" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domain:WeekDay" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Преподаватель:" Style="{StaticResource ToolbarLabel}" Margin="0,0,6,0" />
            <ComboBox Width="320" ItemsSource="{Binding Teachers}" SelectedItem="{Binding SelectedTeacher}"
                      DisplayMemberPath="Name" />
            <Button Content="＋ Добавить ограничение" Command="{Binding AddCommand}" />
            <Button Content="🗑 Удалить выбранное" Command="{Binding RemoveCommand}" />
            <Button Content="💾 Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="10,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Background="{DynamicResource SubtleBackgroundBrush}">
            <TextBlock Text="{Binding HardHint}" Style="{StaticResource MutedText}" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="Тип" SelectedItemBinding="{Binding Kind}"
                                            ItemsSource="{Binding Source={StaticResource PreferenceKinds}}" Width="200" />
                    <DataGridComboBoxColumn Header="День" SelectedItemBinding="{Binding Day}"
                                            ItemsSource="{Binding Source={StaticResource WeekDays}}" Width="130" />
                    <DataGridTemplateColumn Header="Слот" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TimeSlotId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Slots, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding TimeSlotId}" DisplayMemberPath="Display"
                                          SelectedValuePath="Id" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Аудитория" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AuditoriumId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Auditoriums, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding AuditoriumId}" DisplayMemberPath="Number"
                                          SelectedValuePath="Id" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Вес (0–100)" Binding="{Binding Weight}" Width="110" />
                    <DataGridCheckBoxColumn Header="Жёсткое" Binding="{Binding IsHard}" Width="90" />
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
