<UserControl x:Class="ScheduleApp.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Панель управления ===== -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Отображение:" Style="{StaticResource ToolbarLabel}" />
                    <ComboBox Width="150" SelectedItem="{Binding ViewMode}"
                              ItemsSource="{Binding ViewModes}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Группировка:" Style="{StaticResource ToolbarLabel}" Margin="10,0,4,0" />
                    <ComboBox Width="160" SelectedItem="{Binding Grouping}"
                              ItemsSource="{Binding GroupingModes}"
                              IsEnabled="{Binding IsByEntityMode, Converter={StaticResource InverseBool}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Аудитория / преподаватель:" Style="{StaticResource ToolbarLabel}" Margin="10,0,4,0"
                               Visibility="{Binding ShowEntityPickers, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox Width="130"
                              Visibility="{Binding ShowEntityPickers, Converter={StaticResource BoolToVisibility}}"
                              ItemsSource="{Binding Rooms}" SelectedItem="{Binding ContextRoom}"
                              DisplayMemberPath="Name" />

                    <ComboBox Width="130"
                              Visibility="{Binding ShowEntityPickers, Converter={StaticResource BoolToVisibility}}"
                              ItemsSource="{Binding Teachers}" SelectedItem="{Binding ContextTeacher}"
                              DisplayMemberPath="Name" />

                    <TextBlock Text="Разрез:" Style="{StaticResource ToolbarLabel}" Margin="10,0,4,0"
                               Visibility="{Binding IsSummaryMode, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox Width="140" ItemsSource="{Binding SummaryDimensions}"
                              SelectedItem="{Binding SummaryDimension}"
                              Visibility="{Binding IsSummaryMode, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Период:" Style="{StaticResource ToolbarLabel}" Margin="10,0,4,0" />
                    <ComboBox Width="230" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}"
                              DisplayMemberPath="Name" />
                </WrapPanel>

                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Фильтры:" Style="{StaticResource ToolbarLabel}" />
                    <ComboBox Width="170" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Name" />
                    <ComboBox Width="200" ItemsSource="{Binding Teachers}" SelectedItem="{Binding SelectedTeacher}" DisplayMemberPath="Name" />
                    <ComboBox Width="150" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" />
                    <ComboBox Width="170" ItemsSource="{Binding Disciplines}" SelectedItem="{Binding SelectedDiscipline}" DisplayMemberPath="Name" />
                    <Button Content="Сбросить" Command="{Binding ClearFiltersCommand}" />

                    <CheckBox Content="Транспонировать" IsChecked="{Binding Transposed}" Margin="10,0,0,0" />

                    <TextBlock Text="Масштаб:" Style="{StaticResource ToolbarLabel}" Margin="12,0,4,0" />
                    <Slider Width="140" Minimum="25" Maximum="150" Value="{Binding Zoom}" TickFrequency="25"
                            IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Zoom, StringFormat={}{0:F0}%}" Style="{StaticResource ToolbarLabel}"
                               Margin="6,0,0,0" MinWidth="42" />

                    <Button Content="⟳ Обновить" Command="{Binding RefreshCommand}" Margin="10,0,6,0" />
                    <Button Content="📊 Excel" Command="{Binding ExportExcelCommand}" />
                    <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== Заголовок шахматки (закреплён по вертикали, синхронизирован по горизонтали) ===== -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="HeaderScroll" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" Background="Transparent">
                <ItemsControl ItemsSource="{Binding Grid.Sections[0].Columns}" Margin="118,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                                    Width="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Height="44" Padding="4,2"
                                    Visibility="{Binding Header, Converter={StaticResource NullToVisibility}}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource HeaderForegroundBrush}"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubHeader}" FontSize="10" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource HeaderForegroundBrush}" Opacity="0.7"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ===== Тело шахматки ===== -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Padding="0,0,0,6">
            <ItemsControl ItemsSource="{Binding Grid.Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,10,10,6">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" FontSize="14"
                                       Margin="2,0,0,6"
                                       Visibility="{Binding Title, Converter={StaticResource NullToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Заголовок строки -->
                                            <Border Width="118" Height="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Background="{DynamicResource SubtleBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Padding="6,2">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="11.5"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" />
                                                    <TextBlock Text="{Binding SubHeader}" FontSize="10"
                                                               Style="{StaticResource MutedText}" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Ячейки строки -->
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border AllowDrop="True" Tag="{Binding}"
                                                                Background="{DynamicResource EmptyCellBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1"
                                                                Width="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Height="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Padding="2"
                                                                DragOver="Cell_DragOver" Drop="Cell_Drop"
                                                                MouseRightButtonUp="Cell_RightClick">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEmptyHighlight}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource EmptyCellHighlightBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.ToolTip>
                                                                <ToolTip Content="{Binding Hint}" />
                                                            </Border.ToolTip>
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                <ItemsControl ItemsSource="{Binding Tiles}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="0,0,0,2" CornerRadius="4" Padding="4,2"
                                                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                                                    BorderThickness="1" BorderBrush="{DynamicResource TileBorderBrush}"
                                                                                    Cursor="Hand"
                                                                                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                                                                                    MouseMove="Tile_MouseMove"
                                                                                    MouseRightButtonUp="Tile_RightClick">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource ConflictBrush}" />
                                                                                                <Setter Property="BorderThickness" Value="2.5" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource LockedBrush}" />
                                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Border.ToolTip>
                                                                                    <ToolTip Content="{Binding ToolTip}" />
                                                                                </Border.ToolTip>
                                                                                <Grid>
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Line1}" FontWeight="SemiBold"
                                                                                                   FontSize="{Binding DataContext.TileFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                   Foreground="White" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding Line2}" FontSize="{Binding DataContext.TileFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                   Foreground="White" Opacity="0.92" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding Line3}" FontSize="{Binding DataContext.TileFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                   Foreground="White" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="🔒" FontSize="10" HorizontalAlignment="Right"
                                                                                               VerticalAlignment="Top"
                                                                                               Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Подсказка при пустом расписании -->
        <Border Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="24"
                Visibility="{Binding Grid.HasLessons, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel>
                <TextBlock Text="Расписание пустое" Style="{StaticResource TitleText}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" MaxWidth="460" TextAlignment="Center"
                           Text="Перейдите на вкладку «Генерация», выберите режим и период — расписание построится автоматически. Занятия также можно добавлять вручную правой кнопкой по ячейке." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
