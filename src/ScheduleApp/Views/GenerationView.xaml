<UserControl x:Class="ScheduleApp.Views.GenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12" MaxWidth="1200">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: параметры запуска -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Что делать?" Style="{StaticResource SectionTitle}" />
                        <RadioButton Content="Полная перегенерация" GroupName="mode"
                                     IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource ModeEquals}, ConverterParameter=Full}" />
                        <RadioButton Content="Инкрементальная (сохранять заблокированные)" GroupName="mode"
                                     IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource ModeEquals}, ConverterParameter=Incremental}" />
                        <RadioButton Content="Только дораспределить пустые слоты" GroupName="mode"
                                     IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource ModeEquals}, ConverterParameter=FillEmpty}" />
                        <RadioButton Content="Только проверка ограничений" GroupName="mode"
                                     IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource ModeEquals}, ConverterParameter=ValidateOnly}" />
                        <TextBlock Text="{Binding ModeDescriptions}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Режим генерации (алгоритм)" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding Complexities}" SelectedItem="{Binding Complexity}" Width="220"
                                  HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding AlgorithmInfo}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Период расписания" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                                  DisplayMemberPath="Name" Width="320" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="▶ Сгенерировать расписание" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}" FontSize="14" Padding="18,9" />
                    <Button Content="■ Отмена" Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Правая колонка: прогресс и результат -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Ход выполнения" Style="{StaticResource SectionTitle}" />
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="10" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ProgressMessage}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" Margin="8,0,0,0"
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Log}" Margin="0,8,0,0" Height="160"
                                 FontFamily="Consolas" FontSize="11" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Результат" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
