<Window x:Class="ScheduleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ScheduleApp.Views"
        Title="Расписание — генератор учебного расписания"
        Height="900" Width="1500" WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="1000"
        WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Собственный заголовок окна: системные кнопки свернуть/развернуть/закрыть отключены -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок приложения -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="16,12"
                MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📅" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Расписание" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                        <TextBlock Text="Автоматическая генерация учебного расписания с учётом жёстких и мягких ограничений"
                                   FontSize="11.5" Foreground="{DynamicResource HeaderForegroundBrush}" Opacity="0.75" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource HeaderForegroundBrush}"
                               Opacity="0.85" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Big Pickle" Opacity="0.5" FontSize="11"
                               Foreground="{DynamicResource HeaderForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Круглые кнопки управления окном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButton}"
                            Click="OnMinimizeClick" ToolTip="Свернуть">
                        <Path Data="M 1,6 L 11,6" Stroke="{DynamicResource HeaderForegroundBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}"
                            Click="OnMaximizeClick" ToolTip="Развернуть">
                        <Grid>
                            <Path x:Name="MaximizeIcon" Data="M 0.5,0.5 L 11.5,0.5 L 11.5,11.5 L 0.5,11.5 Z"
                                  Stroke="{DynamicResource HeaderForegroundBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" />
                            <Path x:Name="RestoreIcon" Visibility="Collapsed"
                                  Data="M 3.5,0.5 L 11.5,0.5 L 11.5,8.5 M 0.5,3.5 L 0.5,11.5 L 8.5,11.5 L 8.5,3.5 Z"
                                  Stroke="{DynamicResource HeaderForegroundBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" />
                        </Grid>
                    </Button>
                    <Button x:Name="ExitButton" Style="{StaticResource WindowExitButton}"
                            Click="OnExitClick" ToolTip="Выход">
                        <Path Data="M 0.5,0.5 L 11.5,11.5 M 11.5,0.5 L 0.5,11.5"
                              Stroke="{DynamicResource HeaderForegroundBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Расписание">
                <views:ScheduleView DataContext="{Binding Schedule}" />
            </TabItem>
            <TabItem Header="Справочники">
                <views:DictionariesView DataContext="{Binding Dictionaries}" />
            </TabItem>
            <TabItem Header="Ограничения">
                <views:ConstraintsView DataContext="{Binding Constraints}" />
            </TabItem>
            <TabItem Header="Генерация">
                <views:GenerationView DataContext="{Binding Generation}" />
            </TabItem>
            <TabItem Header="Отчёты">
                <views:ReportsView DataContext="{Binding Reports}" />
            </TabItem>
            <TabItem Header="Настройки">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
        </Border>
    </Grid>
</Window>
